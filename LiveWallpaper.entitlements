<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- M0 sandbox spike: the whole point is to confirm a sandboxed app can still create a
         desktop-level window on macOS 26. Set app-sandbox to false to A/B test the difference. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- Workshop downloads (Phase 2) — harmless to include now. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Importing a local .livewallpaper (open panel) and exporting one (save panel). -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <!-- Now-playing wallpapers script Music/Spotify (via Apple Events) to read the current track
         and album art. Under the sandbox each scriptable target must be listed explicitly. The
         user still approves the Automation prompt per app on first use. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    <key>com.apple.security.temporary-exception.apple-events</key>
    <array>
        <string>com.apple.Music</string>
        <string>com.spotify.client</string>
    </array>
</dict>
</plist>
