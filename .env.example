# LiveWallpaper — workshop seeding secrets (PocketBase).
# Copy to `.env` (gitignored) and fill in. Used ONLY by scripts/seed-workshop.sh on your machine.
# The app itself needs NO secrets — it only ships the public PocketBase URL in WorkshopConfig.swift.

# Your PocketBase instance, e.g. https://api.yourdomain.com  (or http://SERVER_IP:8090 while testing)
PB_URL=https://YOUR-POCKETBASE-HOST

# Superuser (admin) credentials — used to create catalog records during seeding.
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=
