# LiveWallpaper — workshop seeding/admin secrets.
# Copy to `.env` (which is gitignored) and fill in. Used ONLY by scripts/seed-workshop.sh.
# NONE of these belong in the app or in git. The app ships only the public values in
# Sources/LiveWallpaper/WorkshopConfig.swift (Supabase URL, anon key, R2 public base).

# --- Supabase (admin) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# service_role key — bypasses Row-Level Security. SECRET. Seeding/admin only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 (S3-compatible, for uploads) ---
R2_S3_ENDPOINT=https://YOUR-ACCOUNT-ID.r2.cloudflarestorage.com
R2_BUCKET=lw-wallpapers
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public base URL the app downloads from (also goes in WorkshopConfig.swift).
R2_PUBLIC_BASE=https://pub-XXXX.r2.dev
